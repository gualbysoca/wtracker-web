# =====================================================
# .env.example — Variables de entorno para Docker Compose
# Copiar como .env y configurar valores reales
# =====================================================

# Base de Datos PostgreSQL
DB_NAME=wtracker_db
DB_USER=wtracker
DB_PASSWORD=tu_password_segura_aqui

# JWT Secrets (mínimo 32 caracteres, usar valores aleatorios en prod)
JWT_SECRET=cambia_esto_por_un_secreto_aleatorio_de_minimo_32_chars
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_aleatorio_de_minimo_32_chars
